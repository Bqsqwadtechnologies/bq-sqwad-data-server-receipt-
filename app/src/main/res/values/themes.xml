<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BQSqwadDataReceipt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/sky_primary</item>
        <item name="colorPrimaryDark">@color/sky_primary_dark</item>
        <item name="colorAccent">@color/sky_primary</item>
    </style>

    <style name="Theme.BQSqwadDataReceipt.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BQSqwadDataReceipt</item>
    </style>
</resources>
